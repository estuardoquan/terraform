#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [docker, wheel]
    shell: /bin/sh
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/resolv.conf
    permissions: "0644"
    owner: root:root
    content: |
%{ for ns in nameservers ~}
      nameserver ${ns}
%{ endfor ~}

