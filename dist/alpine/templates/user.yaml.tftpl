#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [docker, wheel]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /var/tmp/nsupdate.key
    permissions: "0600"
    owner: root:root
    content: |
      key "acme-update-key" {
         algorithm hmac-sha512;
         secret "${nsupdate_key_secret}";
      };
      
