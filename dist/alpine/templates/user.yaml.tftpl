#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [docker, wheel]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

runcmd:
  - git clone https://github.com/estuardoquan/opt-bin.git /opt/bin
  - git clone https://github.com/estuardoquan/openrc-services.git /opt/services
  - chown 1000:1000 -R /opt/bin /opt/services
  - find /opt/bin -type f -name '*.sh' -exec cp {} /usr/local/bin/ \;
  - ln -s /opt/services/vlan/vlan /etc/init.d/vlan
  - rc-update add vlan default
  - rc-service vlan start
