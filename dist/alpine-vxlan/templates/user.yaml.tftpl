#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [docker, wheel]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /home/${username}/.ssh/id_ed25519
    permissions: "0600"
    owner: ${username}:${username}
    defer: true
    content: |
      ${indent(6, github_private_key)}
  - path: /home/${username}/.ssh/id_ed25519.pub
    permissions: "0644"
    owner: ${username}:${username}
    defer: true
    content: |
      ${github_public_key}

manage_resolv_conf: true
resolv_conf:
  nameservers: ${jsonencode(nameservers)}

package_update: true
packages:
  - lua-language-server
  - clang-extra-tools
  - tree-sitter-cli
  - build-base
