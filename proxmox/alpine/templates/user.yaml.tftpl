#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [docker, wheel]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

%{ if swap_size != "" ~}
swap:
  filename: /swapfile
  size: ${swap_size}
  maxsize: ${swap_size}
%{ endif ~}

%{ if length(disk_mounts) > 0 ~}
mounts: ${jsonencode(disk_mounts)}
%{ endif ~}

write_files:
  - path: /home/${username}/.ssh/id_ed25519
    permissions: "0600"
    owner: ${username}:${username}
    defer: true
    content: |
      ${indent(6, github_private_key)}
  - path: /home/${username}/.ssh/id_ed25519.pub
    permissions: "0644"
    owner: ${username}:${username}
    defer: true
    content: |
      ${github_public_key}

manage_resolv_conf: true

resolv_conf:
  nameservers: ${jsonencode(nameservers)}

package_update: true

%{ if length(default_bootcmd) + length(bootcmd) + length(disk_bootcmd) > 0 ~}
bootcmd: ${jsonencode(concat(default_bootcmd, disk_bootcmd, bootcmd))}
%{ endif ~}

%{ if length(default_packages) + length(packages) > 0 ~}
packages: ${jsonencode(concat(default_packages, packages))}
%{ endif ~}

%{ if length(default_runcmd) + length(runcmd) > 0 ~}
runcmd: ${jsonencode(concat(default_runcmd, runcmd))}
%{ endif ~}
