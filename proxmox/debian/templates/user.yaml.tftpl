#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

%{ if swap != "" ~}
swap:
  filename: /swapfile
  size: ${swap}
  maxsize: ${swap}
%{ endif ~}

%{ if length(mounts) > 0 ~}
mounts: ${jsonencode(mounts)}
%{ endif ~}

write_files:
  - path: /etc/resolv.conf
    permissions: "0644"
    owner: root:root
    content: |
%{ for ns in nameservers ~}
      nameserver ${ns}
%{ endfor ~}
  - path: /home/${username}/.ssh/id_ed25519
    permissions: "0600"
    owner: ${username}:${username}
    defer: true
    content: |
      ${indent(6, github_private_key)}
  - path: /home/${username}/.ssh/id_ed25519.pub
    permissions: "0644"
    owner: ${username}:${username}
    defer: true
    content: |
      ${github_public_key}

package_update: true

%{ if length(bootcmd) > 0 ~}
bootcmd: ${jsonencode(bootcmd)}
%{ endif ~}

%{ if length(length(packages) > 0 ~}
packages: ${jsonencode(packages)}
%{ endif ~}

%{ if length(runcmd) > 0 ~}
runcmd: ${jsonencode(runcmd)}
%{ endif ~}
