#cloud-config
hostname: ${hostname}
fqdn: ${hostname}
manage_etc_hosts: true

users:
  - name: ${username}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/rancher/k3s/config.yaml
    permissions: "0600"
    owner: root:root
    content: |
      token: ${k3s_token}
%{ if bootstrap ~}
      cluster-init: true
%{ else ~}
      server: https://${bootstrap_address}:6443
%{ endif ~}
      tls-san:
%{ for san in tls_sans ~}
        - ${san}
%{ endfor ~}
      write-kubeconfig-mode: "0640"
      disable:
        - servicelb

runcmd:
  - [ systemctl, enable, --now, k3s ]
